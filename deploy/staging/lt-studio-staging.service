[Unit]
Description=LT Studio synthetic staging API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ltstudio
Group=ltstudio
WorkingDirectory=/opt/lt-studio/current
EnvironmentFile=/etc/lt-studio/staging.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lt-studio-data /srv/lt-studio-backups /srv/lt-studio-restore /srv/lt-studio-ops
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
