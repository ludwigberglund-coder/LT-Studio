# Public template only. Never commit real secret values.
NODE_ENV=production
ROLLANDS_ENV=staging
ROLLANDS_DATA_CLASSIFICATION=synthetic
ROLLANDS_REAL_DATA_ALLOWED=0
ROLLANDS_DEMO_DATA=0

ROLLANDS_API_HOST=127.0.0.1
PORT=4180
ROLLANDS_ALLOWED_HOSTS=<STAGING_HOST>
ROLLANDS_API_SECURE_COOKIE=1

ROLLANDS_DATABASE_PATH=/srv/lt-studio-data/platform.sqlite
ROLLANDS_BACKUP_PATH=/srv/lt-studio-backups
ROLLANDS_RESTORE_DRILL_PATH=/srv/lt-studio-restore
ROLLANDS_PILOT_OPERATIONS_PATH=/etc/lt-studio/staging-operations.json

ROLLANDS_AUTH_ENCRYPTION_KEY=<SECRET_STORE_VALUE>
ROLLANDS_BACKUP_ENCRYPTION_KEY=<SECRET_STORE_VALUE>

ROLLANDS_STAGING_ALPHA_PASSWORD=<SECRET_STORE_VALUE>
ROLLANDS_STAGING_ALPHA_MFA_SECRET=<SECRET_STORE_VALUE>
ROLLANDS_STAGING_BETA_PASSWORD=<SECRET_STORE_VALUE>
ROLLANDS_STAGING_BETA_MFA_SECRET=<SECRET_STORE_VALUE>

R2_STAGING_AUDIT_EVIDENCE_PATH=/srv/lt-studio-ops/r2-staging-audit-evidence.json
ROLLANDS_OFFSITE_BACKUP_EVIDENCE_PATH=/srv/lt-studio-ops/offsite-backup-evidence.json
ROLLANDS_RESTORE_DRILL_EVIDENCE_PATH=/srv/lt-studio-ops/restore-drill-evidence.json
ROLLANDS_R2_RESTORE_DRILL_EVIDENCE_PATH=/srv/lt-studio-ops/r2-restore-drill-evidence.json
ROLLANDS_MONITORING_EVIDENCE_PATH=/srv/lt-studio-ops/monitoring-evidence.json
ROLLANDS_LOGGING_EVIDENCE_PATH=/srv/lt-studio-ops/logging-evidence.json
ROLLANDS_AUDIT_ANCHOR_PATH=/srv/lt-studio-ops/audit-anchor.json
ROLLANDS_AUDIT_ANCHOR_EVIDENCE_PATH=/srv/lt-studio-ops/audit-anchor-evidence.json
ROLLANDS_UAT_EVIDENCE_PATH=/srv/lt-studio-ops/uat-evidence.json
ROLLANDS_STAGING_SIGNOFF_PATH=/srv/lt-studio-ops/staging-signoff.json
ROLLANDS_RELEASE_COMMIT=<FULL_40_CHARACTER_GIT_SHA>

# R2 values must be staging-only credentials/buckets in the secret store.
R2_STAGING_ENABLED=1
R2_STAGING_JURISDICTION=eu
R2_STAGING_ACCOUNT_ID=<SECRET_STORE_VALUE>
R2_STAGING_BUCKET=<STAGING_RUNTIME_BUCKET>
R2_STAGING_ACCESS_KEY_ID=<SECRET_STORE_VALUE>
R2_STAGING_SECRET_ACCESS_KEY=<SECRET_STORE_VALUE>

R2_BACKUP_ENABLED=1
R2_BACKUP_JURISDICTION=eu
R2_BACKUP_ACCOUNT_ID=<SECRET_STORE_VALUE>
R2_BACKUP_BUCKET=<STAGING_BACKUP_BUCKET>
R2_BACKUP_ACCESS_KEY_ID=<SECRET_STORE_VALUE>
R2_BACKUP_SECRET_ACCESS_KEY=<SECRET_STORE_VALUE>

R2_AUDIT_ENABLED=1
R2_AUDIT_JURISDICTION=eu
R2_AUDIT_ACCOUNT_ID=<SECRET_STORE_VALUE>
R2_AUDIT_BUCKET=<STAGING_AUDIT_BUCKET>
R2_AUDIT_ACCESS_KEY_ID=<SECRET_STORE_VALUE>
R2_AUDIT_SECRET_ACCESS_KEY=<SECRET_STORE_VALUE>
