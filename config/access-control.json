  "roles": [
    {
      "id": "system-admin",
      "label": "Systemadministratör",
      "description": "Teknisk administration och användarhantering. Rollen ska inte användas för daglig bokföring eller attest.",
      "permissions": [
        "platform.settings.manage",
        "users.manage",
        "website.manage",
        "audit.view",
        "reports.view"
      ]
    },
    {
      "id": "accountant",
      "label": "Ekonom",
      "description": "Löpande bokföring, fakturaregistrering, bankavstämning och rapportering utan rätt att ensam frisläppa betalningar.",
      "permissions": [
        "audit.view",
        "documents.view",
        "documents.upload",
        "accounting.view",
        "accounting.post",
        "accounting.correct",
        "customer-invoice.view",
        "customer-invoice.create",
        "customer-invoice.comment",
        "customer-invoice.remind",
        "customer-invoice.issue",
        "customer-invoice.credit",
        "supplier.view",
        "supplier.manage",
        "supplier-invoice.view",
        "supplier-invoice.register",
        "payment.view",
        "payment.prepare",
        "bank.view",
        "bank.import",
        "bank.reconcile",
        "inventory.view",
        "reports.view",
        "reports.export"
      ]
    },
    {
      "id": "approver",
      "label": "Attestant",
      "description": "Oberoende attest av leverantörsfakturor, leverantörers betalningsuppgifter och betalningar samt periodlåsning.",
      "permissions": [
        "audit.view",
        "documents.view",
        "accounting.view",
        "period.lock",
        "supplier.view",
        "supplier.bank-account.approve",
        "supplier-invoice.view",
        "supplier-invoice.approve",
        "payment.view",
        "payment.release",
        "bank.view",
        "reports.view"
      ]
    },
    {
      "id": "controller",
      "label": "Ekonomikontrollant",
      "description": "Oberoende kontroll, rättelser, leverantörskontroll och styrning av perioder. Upplåsning kräver separat person enligt arbetsflödet.",
      "permissions": [
        "audit.view",
        "documents.view",
        "accounting.view",
        "accounting.correct",
        "period.lock",
        "period.unlock",
        "customer-invoice.view",
        "customer-invoice.comment",
        "supplier.view",
        "supplier.bank-account.approve",
        "supplier-invoice.view",
        "payment.view",
        "bank.view",
        "inventory.view",
        "payroll.view",
        "reports.view",
        "reports.export"
      ]
    },
    {
      "id": "sales",
      "label": "Försäljning och kassa",
      "description": "Kundfakturor och kunddialog utan åtkomst till leverantörsattest, löner eller periodupplåsning.",
      "permissions": [
        "customer-invoice.view",
        "customer-invoice.create",
        "customer-invoice.comment",
        "customer-invoice.remind",
        "customer-invoice.issue",
        "payment.view",
        "reports.view"
      ]
    },
    {
      "id": "inventory-manager",
      "label": "Lageransvarig",
      "description": "Artiklar, inventering, svinn och inköpsrelaterad registrering.",
      "permissions": [
        "documents.view",
        "documents.upload",
        "supplier.view",
        "supplier.manage",
        "supplier-invoice.view",
        "supplier-invoice.register",
        "inventory.view",
        "inventory.manage",
        "inventory.adjust",
        "reports.view"
      ]
    },
    {
      "id": "payroll-admin",
      "label": "Löneansvarig",
      "description": "Löneunderlag och lönejournal med avgränsad åtkomst till övrig ekonomi.",
      "permissions": [
        "audit.view",
        "accounting.view",
        "payroll.view",
        "payroll.import",
        "reports.view"
      ]
    },
    {
      "id": "auditor",
      "label": "Revisor / läsbehörig granskare",
      "description": "Skrivskyddad insyn i ekonomin och full åtkomst till revisionsunderlag.",
      "permissions": [
        "audit.view",
        "documents.view",
        "accounting.view",
        "customer-invoice.view",
        "supplier.view",
        "supplier-invoice.view",
        "payment.view",
        "bank.view",
        "inventory.view",
        "payroll.view",
        "reports.view",
        "reports.export"
      ]
    }
  ],
  "workflows": [
    {
      "id": "supplier-invoice-approval",
      "label": "Leverantörsfaktura: registrering och attest",
      "requiredPermission": "supplier-invoice.approve",
      "distinctActors": true,
      "fields": [
        {
          "id": "registeredBy",
          "label": "Registrerad av"
        },
        {
          "id": "approvedBy",
          "label": "Attesterad av"
        }
      ],
      "reason": "Den som registrerar leverantörsfakturan får inte ensam attestera samma faktura."
    },
    {
      "id": "supplier-bank-change",
      "label": "Leverantör: ändring och godkännande av betalningsuppgifter",
      "requiredPermission": "supplier.bank-account.approve",
      "distinctActors": true,
      "fields": [
        {
          "id": "requestedBy",
          "label": "Ändring begärd av"
        },
        {
          "id": "approvedBy",
          "label": "Ändring godkänd av"
        }
      ],
      "reason": "Ändring av en leverantörs betalningsuppgifter måste godkännas av en annan behörig person innan de börjar användas."
    },
    {
      "id": "payment-release",
      "label": "Betalning: förberedelse och frisläppning",
      "requiredPermission": "payment.release",
      "distinctActors": true,
      "fields": [
        {
          "id": "preparedBy",
          "label": "Förberedd av"
        },
        {
          "id": "releasedBy",
          "label": "Frisläppt av"
        }
      ],
      "reason": "Den som förbereder en betalning får inte ensam frisläppa samma betalning."
    },
    {
      "id": "period-unlock",
      "label": "Bokföringsperiod: begäran och upplåsning",
      "requiredPermission": "period.unlock",
      "distinctActors": true,
      "fields": [
        {
          "id": "requestedBy",
          "label": "Begärd av"
        },
        {
          "id": "unlockedBy",
          "label": "Upplåst av"
        }
      ],
      "reason": "Upplåsning av en stängd period kräver en separat kontrollperson och ska alltid loggas."
    },
    {
      "id": "inventory-adjustment",
      "label": "Lager: inventering och justeringsgodkännande",
      "requiredPermission": "inventory.adjust",
      "distinctActors": true,
      "fields": [
        {
          "id": "countedBy",
          "label": "Inventerad av"
        },
        {
          "id": "approvedBy",
          "label": "Justering godkänd av"
        }
      ],
      "reason": "Större svinn och lagerjusteringar ska granskas av någon annan än den som inventerade."
    }
  ]
}
