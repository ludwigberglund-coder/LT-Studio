# Rollands staging/pilot deployment template - placeholders only.
# Copy values into the server/secrets manager. Do not commit a real .env file.

NODE_ENV=production
ROLLANDS_ENV=pilot
# For the isolated verification environment, change this to staging.
# Staging is synthetic-only: never use Rolands or any other real customer data.
# When ROLLANDS_ENV=staging, both values below are mandatory and fail closed.
ROLLANDS_DATA_CLASSIFICATION=synthetic
ROLLANDS_REAL_DATA_ALLOWED=0

# Bind API to loopback when a reverse proxy terminates HTTPS on the same server.
ROLLANDS_API_HOST=127.0.0.1
PORT=4180
ROLLANDS_ALLOWED_HOSTS=portal.example.invalid
ROLLANDS_API_SECURE_COOKIE=1
# JSON-lines till stderr för central driftloggning. Skyddade miljöer aktiverar detta som standard.
ROLLANDS_STRUCTURED_LOGS=1

# Absolute paths outside the Git repository, on persistent storage.
ROLLANDS_DATABASE_PATH=/srv/rollands-data/platform.sqlite
ROLLANDS_BACKUP_PATH=/srv/rollands-backups
# Copy config/pilot-operations.example.json to a private file outside the repository, fill it in and approve it before pilot.
ROLLANDS_PILOT_OPERATIONS_PATH=/etc/rollands/pilot-operations.json
# Private UAT/signoff artifacts. Keep them outside GitHub.
ROLLANDS_UAT_EVIDENCE_PATH=/srv/rollands-ops/pilot-uat-evidence.json
ROLLANDS_STAGING_SIGNOFF_PATH=/srv/rollands-ops/staging-signoff.json
# Full 40-character commit deployed to staging and later approved for pilot.
ROLLANDS_RELEASE_COMMIT=REPLACE_WITH_FULL_40_CHARACTER_GIT_SHA

# Generate a long random value in the deployment secrets manager. Never reuse this placeholder.
ROLLANDS_AUTH_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Separate secret used only for backup encryption. Keep it in the deployment secret manager.
ROLLANDS_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_SEPARATE_AT_LEAST_32_RANDOM_CHARACTERS

# Demo data must be disabled for pilot/production.
ROLLANDS_DEMO_DATA=0

# One-time bootstrap values. Remove them from the runtime environment after bootstrap.
# In staging, all bootstrap identities must be fictitious and must not be copied from Rolands,
# another customer, production, pilot backups, invoices, documents or accounting exports.
ROLLANDS_BOOTSTRAP_COMPANY_LEGAL_NAME=REPLACE_WITH_LEGAL_NAME
ROLLANDS_BOOTSTRAP_COMPANY_DISPLAY_NAME=REPLACE_WITH_DISPLAY_NAME
ROLLANDS_BOOTSTRAP_COMPANY_ORG_NUMBER=REPLACE_WITH_ORG_NUMBER
ROLLANDS_BOOTSTRAP_USERNAME=REPLACE_WITH_PERSONAL_USERNAME
ROLLANDS_BOOTSTRAP_DISPLAY_NAME=REPLACE_WITH_PERSON_NAME
ROLLANDS_BOOTSTRAP_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
ROLLANDS_BOOTSTRAP_MFA_SECRET=REPLACE_WITH_NEW_TOTP_SECRET

# Private paths used by the isolated restore drill. Keep them outside the repository.
ROLLANDS_RESTORE_DRILL_PATH=/srv/rollands-restore-drill
ROLLANDS_RESTORE_DRILL_EVIDENCE_PATH=/srv/rollands-ops/restore-drill-evidence.json
# Evidence from a restore drill that first downloads the encrypted backup back from R2.
ROLLANDS_R2_RESTORE_DRILL_EVIDENCE_PATH=/srv/rollands-ops/r2-restore-drill-evidence.json
# Private JSON evidence written only after verified encrypted R2 upload + read-back.
ROLLANDS_OFFSITE_BACKUP_EVIDENCE_PATH=/srv/rollands-ops/offsite-backup-evidence.json
# Private JSON evidence from external monitoring/alert test. Must not live in the repository.
ROLLANDS_MONITORING_EVIDENCE_PATH=/srv/rollands-ops/monitoring-evidence.json
# External monitor must probe the public HTTPS core-readiness endpoint.
ROLLANDS_MONITORING_ENDPOINT=https://REPLACE_WITH_STAGING_HOST/api/v1/readiness/core
ROLLANDS_MONITORING_PROVIDER=REPLACE_WITH_MONITORING_PROVIDER
ROLLANDS_MONITORING_ALERT_ROUTE=REPLACE_WITH_ALERT_ROUTE
# Set to 1 only after a real provider test alert has been received.
ROLLANDS_MONITORING_ALERT_DELIVERED=0
ROLLANDS_MONITORING_ALERT_TESTED_AT=
ROLLANDS_MONITORING_ALERT_TEST_REFERENCE=REPLACE_WITH_PROVIDER_ALERT_REFERENCE
# Can be a named person or an operational function, but must identify who observed delivery.
ROLLANDS_MONITORING_ALERT_OBSERVER=REPLACE_WITH_ALERT_OBSERVER

# Private evidence that stderr is actually transported to the chosen central log service.
ROLLANDS_LOGGING_EVIDENCE_PATH=/srv/rollands-ops/logging-evidence.json
ROLLANDS_LOGGING_PROVIDER=REPLACE_WITH_LOGGING_PROVIDER
# Logical destination/index/stream name only; never put credentials here.
ROLLANDS_LOGGING_DESTINATION=REPLACE_WITH_LOGGING_DESTINATION
# Copy a real X-Request-Id from staging and confirm that this exact id is searchable in the central destination.
ROLLANDS_LOGGING_TEST_REQUEST_ID=
ROLLANDS_LOGGING_TESTED_AT=
ROLLANDS_LOGGING_LOOKUP_REFERENCE=REPLACE_WITH_LOOKUP_OR_TICKET_REFERENCE
ROLLANDS_LOGGING_OBSERVER=REPLACE_WITH_LOG_LOOKUP_OBSERVER
ROLLANDS_LOGGING_REQUEST_ID_FOUND=0
# Must match logRetentionDays in the private pilot operations file.
ROLLANDS_LOGGING_RETENTION_DAYS=30
# Set each flag to 1 only after the real hosting/logging configuration has been checked.
ROLLANDS_LOGGING_TRANSPORT_ENCRYPTED=0
ROLLANDS_LOGGING_ACCESS_RESTRICTED=0
ROLLANDS_LOGGING_ALERT_SECURITY_EVENT=0
ROLLANDS_LOGGING_ALERT_5XX=0
ROLLANDS_LOGGING_ALERT_STREAM_MISSING=0
ROLLANDS_LOGGING_ALERTING_REFERENCE=REPLACE_WITH_ALERT_CONFIGURATION_REFERENCE


# --- Staging-only R2 verification ---
# Set ROLLANDS_ENV=staging before using these values. Keep real credentials in the deployment secret manager, never in GitHub.
R2_STAGING_ENABLED=0
R2_STAGING_JURISDICTION=eu
R2_STAGING_ACCOUNT_ID=REPLACE_WITH_32_HEX_R2_ACCOUNT_ID
R2_STAGING_BUCKET=REPLACE_WITH_PRIVATE_STAGING_OBJECT_BUCKET
R2_STAGING_ACCESS_KEY_ID=REPLACE_WITH_STAGING_OBJECT_ACCESS_KEY
R2_STAGING_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_OBJECT_SECRET_KEY
# Optional temporary credential token.
R2_STAGING_SESSION_TOKEN=
R2_STAGING_AUDIT_EVIDENCE_PATH=/srv/rollands-ops/r2-staging-audit.json

# Use a separate private bucket for encrypted disaster-recovery backups.
R2_BACKUP_ENABLED=0
R2_BACKUP_JURISDICTION=eu
R2_BACKUP_ACCOUNT_ID=REPLACE_WITH_32_HEX_R2_ACCOUNT_ID
R2_BACKUP_BUCKET=REPLACE_WITH_SEPARATE_PRIVATE_BACKUP_BUCKET
R2_BACKUP_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ACCESS_KEY
R2_BACKUP_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET_KEY
R2_BACKUP_SESSION_TOKEN=
ROLLANDS_OFFSITE_BACKUP_EVIDENCE_PATH=/srv/rollands-ops/offsite-backup-evidence.json


# --- Independent audit-history anchor ---
# Keep the local anchor and upload evidence outside GitHub.
ROLLANDS_AUDIT_ANCHOR_PATH=/srv/rollands-ops/audit-anchor.json
ROLLANDS_AUDIT_ANCHOR_EVIDENCE_PATH=/srv/rollands-ops/audit-anchor-r2-evidence.json
# Use a bucket and access key scope that are separate from runtime objects and disaster-recovery backup.
R2_AUDIT_ENABLED=0
R2_AUDIT_JURISDICTION=eu
R2_AUDIT_ACCOUNT_ID=REPLACE_WITH_32_HEX_R2_ACCOUNT_ID
R2_AUDIT_BUCKET=REPLACE_WITH_SEPARATE_PRIVATE_AUDIT_BUCKET
R2_AUDIT_ACCESS_KEY_ID=REPLACE_WITH_SEPARATE_AUDIT_ACCESS_KEY
R2_AUDIT_SECRET_ACCESS_KEY=REPLACE_WITH_SEPARATE_AUDIT_SECRET_KEY
R2_AUDIT_SESSION_TOKEN=
