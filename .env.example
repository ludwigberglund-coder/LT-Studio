# Rollands pilot deployment template - placeholders only.
# Copy values into the server/secrets manager. Do not commit a real .env file.

NODE_ENV=production
ROLLANDS_ENV=pilot

# Bind API to loopback when a reverse proxy terminates HTTPS on the same server.
ROLLANDS_API_HOST=127.0.0.1
PORT=4180
ROLLANDS_ALLOWED_HOSTS=portal.example.invalid
ROLLANDS_API_SECURE_COOKIE=1

# Absolute paths outside the Git repository, on persistent storage.
ROLLANDS_DATABASE_PATH=/srv/rollands-data/platform.sqlite
ROLLANDS_BACKUP_PATH=/srv/rollands-backups
# Copy config/pilot-operations.example.json to a private file outside the repository, fill it in and approve it before pilot.
ROLLANDS_PILOT_OPERATIONS_PATH=/etc/rollands/pilot-operations.json

# Generate a long random value in the deployment secrets manager. Never reuse this placeholder.
ROLLANDS_AUTH_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Use a different long random value from the MFA/auth key. Required by pilot:backup and encrypted restore.
ROLLANDS_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_32_PLUS_RANDOM_CHARACTERS

# Demo data must be disabled for pilot/production.
ROLLANDS_DEMO_DATA=0

# One-time bootstrap values. Remove them from the runtime environment after bootstrap.
ROLLANDS_BOOTSTRAP_COMPANY_LEGAL_NAME=REPLACE_WITH_LEGAL_NAME
ROLLANDS_BOOTSTRAP_COMPANY_DISPLAY_NAME=REPLACE_WITH_DISPLAY_NAME
ROLLANDS_BOOTSTRAP_COMPANY_ORG_NUMBER=REPLACE_WITH_ORG_NUMBER
ROLLANDS_BOOTSTRAP_USERNAME=REPLACE_WITH_PERSONAL_USERNAME
ROLLANDS_BOOTSTRAP_DISPLAY_NAME=REPLACE_WITH_PERSON_NAME
ROLLANDS_BOOTSTRAP_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
ROLLANDS_BOOTSTRAP_MFA_SECRET=REPLACE_WITH_NEW_TOTP_SECRET
